# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://darb_user:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/darb_taxi

# JWT Secrets (replace with strong random 64+ char strings in production)
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# OTP Security (in dev mode, OTP can be logged only when OTP_DEV_ECHO=true)
OTP_SECRET=replace-with-strong-otp-hmac-secret
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=true

# File Storage (local private folder; switch to S3/R2 in production)
UPLOAD_DIR=./uploads_private
SIGNING_SECRET=replace-with-file-signing-secret

# Firebase Cloud Messaging (set ONE of the following outside source control)
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
